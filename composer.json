{
  "name": "open-dxp/advanced-object-search-bundle",
  "license": "GPL-3.0+",
  "type": "opendxp-bundle",
  "config": {
    "sort-packages": true
  },
  "prefer-stable": true,
  "minimum-stability": "dev",
  "require": {
    "php": "~8.3.0 || ~8.4.0",
    "handcraftedinthealps/elasticsearch-dsl": "^8.0",
    "open-dxp/opensearch-client-bundle": "^1.0",
    "open-dxp/elasticsearch-client-bundle": "^1.0",
    "open-dxp/opendxp": "^1.1",
    "symfony/config": "^7.3",
    "symfony/console": "^7.3",
    "symfony/dependency-injection": "^7.3",
    "symfony/event-dispatcher": "^7.3",
    "symfony/http-foundation": "^7.3",
    "symfony/http-kernel": "^7.3",
    "symfony/messenger": "^7.3",
    "symfony/routing": "^7.3"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "OpenDxp\\Bundle\\AdvancedObjectSearchBundle\\": "src/"
    }
  },
  "extra": {
    "opendxp": {
      "bundles": [
        "OpenDxp\\Bundle\\AdvancedObjectSearchBundle\\OpenDxpAdvancedObjectSearchBundle"
      ]
    }
  }
}
