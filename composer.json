{
    "name": "open-dxp/advanced-object-search-bundle",
    "license": "GPL-3.0+",
    "type": "opendxp-bundle",
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "symfony/runtime": true
        }
    },
    "require": {
        "php": "~8.3.0 || ~8.4.0 || ~8.5.0",
        "handcraftedinthealps/elasticsearch-dsl": "^8.0",
        "open-dxp/opensearch-client-bundle": "^1.0",
        "open-dxp/elasticsearch-client-bundle": "^1.0",
        "open-dxp/opendxp": "^1.1",
        "symfony/config": "^7.4",
        "symfony/console": "^7.4",
        "symfony/dependency-injection": "^7.4",
        "symfony/event-dispatcher": "^7.4",
        "symfony/http-foundation": "^7.4",
        "symfony/http-kernel": "^7.4",
        "symfony/messenger": "^7.4",
        "symfony/routing": "^7.4"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-symfony": "^2.0.15",
        "symfony/dotenv": "^7.3",
        "symfony/runtime": "^7.3"
    },
    "autoload": {
        "psr-4": {
            "OpenDxp\\Bundle\\AdvancedObjectSearchBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "files": [
            "kernel/Kernel.php"
        ]
    },
    "extra": {
        "opendxp": {
            "bundles": [
                "OpenDxp\\Bundle\\AdvancedObjectSearchBundle\\OpenDxpAdvancedObjectSearchBundle"
            ]
        }
    }
}
